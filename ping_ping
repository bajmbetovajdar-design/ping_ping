import pygame
from random import randint

pygame.init()
pygame.font.init()

back = (200, 255, 255)
win_width = 600
win_height = 500
window = pygame.display.set_mode((win_width, win_height))
pygame.display.set_caption("Пинг-Пинг")

clock = pygame.time.Clock()
FPS = 60

class GameSprite(pygame.sprite.Sprite):
    def __init__(self, player_image, player_x, player_y, size_x, size_y, player_speed):
        pygame.sprite.Sprite.__init__(self)
        try:
            self.image = pygame.transform.scale(pygame.image.load(player_image), (size_x, size_y))
        except:
            self.image = pygame.Surface((size_x, size_y))
            if size_x == size_y:
                self.image.fill((255, 165, 0)) # Оранжевый мяч
            else:
                self.image.fill((0, 0, 128))   # Синие ракетки

        self.speed = player_speed
        self.rect = self.image.get_rect()
        self.rect.x = player_x
        self.rect.y = player_y

    def reset(self):
        window.blit(self.image, (self.rect.x, self.rect.y))

class Player(GameSprite):
    def update_r(self):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_UP] and self.rect.y > 5:
            self.rect.y -= self.speed
        if keys[pygame.K_DOWN] and self.rect.y < win_height - self.rect.height - 5:
            self.rect.y += self.speed

    def update_l(self):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_w] and self.rect.y > 5:
            self.rect.y -= self.speed
        if keys[pygame.K_s] and self.rect.y < win_height - self.rect.height - 5:
            self.rect.y += self.speed

class Ball(GameSprite):
    def __init__(self, player_image, player_x, player_y, size_x, size_y, player_speed):
        super().__init__(player_image, player_x, player_y, size_x, size_y, player_speed)
        self.speed_x = player_speed
        self.speed_y = player_speed

font = pygame.font.Font(None, 35)
lose1 = font.render('PLAYER 1 LOSE!', True, (180, 0, 0))
lose2 = font.render('PLAYER 2 LOSE!', True, (180, 0, 0))

racket1 = Player('racket.png', 30, 200, 15, 100, 6)
racket2 = Player('racket.png', 550, 200, 15, 100, 6)
ball = Ball('tenis_ball.png', 290, 240, 30, 30, 4)

score_racket1 = 0
score_racket2 = 0
max_score = 5

game = True
finish = False

while game:
    for e in pygame.event.get():
        if e.type == pygame.QUIT:
            game = False

    if not finish:
        window.fill(back)
        
        # Обновление позиций
        racket1.update_l()
        racket2.update_r()
        
        ball.rect.x += ball.speed_x
        ball.rect.y += ball.speed_y

        # Отскок от верхней и нижней границ экрана
        if ball.rect.y <= 0 or ball.rect.y >= win_height - ball.rect.height:
            ball.speed_y *= -1

        # Отскок от ракеток
        if pygame.sprite.collide_rect(racket1, ball):
            ball.speed_x = abs(ball.speed_x)
        if pygame.sprite.collide_rect(racket2, ball):
            ball.speed_x = -abs(ball.speed_x)

        # Пропуск мяча слева (Проиграл Игрок 1)
        if ball.rect.x < 0:
            score_racket2 += 1
            ball.rect.x, ball.rect.y = 290, 240
            ball.speed_x *= -1
            if score_racket2 >= max_score:
                finish = True

        # Пропуск мяча справа (Проиграл Игрок 2)
        if ball.rect.x > win_width:
            score_racket1 += 1
            ball.rect.x, ball.rect.y = 290, 240
            ball.speed_x *= -1
            if score_racket1 >= max_score:
                finish = True

        # Отрисовка счета и объектов
        text_score = font.render(f"{score_racket1} : {score_racket2}", True, (0, 0, 0))
        window.blit(text_score, (win_width // 2 - 30, 20))

        racket1.reset()
        racket2.reset()
        ball.reset()

    else:
        # Экран окончания игры
        window.fill(back)
        if score_racket2 >= max_score:
            window.blit(lose1, (200, 240))
        else:
            window.blit(lose2, (200, 240))

    pygame.display.update()
    clock.tick(FPS)

pygame.quit()

